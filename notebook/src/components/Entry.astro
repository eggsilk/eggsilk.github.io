---
// One row: year (first row of its year only) | title [status] | dd/mm
import { fmtShort, statusLabel } from '../lib/format';

interface Props {
  title: string;
  href?: string;
  created: Date;
  status: string;
  showYear: boolean;
}
const { title, href, created, status, showYear } = Astro.props;
const flag = status === 'published' ? null : statusLabel(status);
const loud = status === 'draft' || status === 'in-revision';
---
<li>
  {href ? (
    <a href={href}>
      {showYear && <span class="yr">{created.getUTCFullYear()}</span>}
      <span class="t">{title}{flag && <span class={loud ? 'flag' : 'flag-quiet'}>{flag}</span>}</span>
      <time datetime={created.toISOString().slice(0, 10)}>{fmtShort(created)}</time>
    </a>
  ) : (
    <div class="row unlinked">
      {showYear && <span class="yr">{created.getUTCFullYear()}</span>}
      <span class="t">{title}{flag && <span class={loud ? 'flag' : 'flag-quiet'}>{flag}</span>}</span>
      <time datetime={created.toISOString().slice(0, 10)}>{fmtShort(created)}</time>
    </div>
  )}
</li>
