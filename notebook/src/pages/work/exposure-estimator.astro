---
import Base from '../../layouts/Base.astro';
---
<Base title="CBAM exposure estimator" section="work" description="Indicative CBAM certificate cost on default values against verified data.">
  <header class="head">
    <h1>CBAM exposure estimator</h1>
    <div class="line">27 June, 2026 · revised 7 September, 2026 · I-001, instrument · <span class="flag">in revision</span></div>
  </header>
  <p>Certificate cost on default values against the cost on verified data, for one import volume. Preset intensities and default values predate the tables in Implementing Regulation (EU) 2025/2621; use the calculation, not the figures.</p>

  <div class="calc">
    <div>
      <div class="field">
        <label for="good">Good</label>
        <select id="good">
          <option value="cement">Cement / clinker</option>
          <option value="steel_bf">Steel, integrated (BF-BOF)</option>
          <option value="steel_eaf">Steel, electric-arc (EAF, scrap)</option>
          <option value="aluminium">Aluminium</option>
          <option value="fertiliser">Fertiliser (urea)</option>
        </select>
      </div>
      <div class="field">
        <label for="vol">Annual volume into the EU, tonnes</label>
        <input id="vol" type="number" min="0" step="100" value="10000" />
      </div>
      <div class="field">
        <label for="year">Compliance year</label>
        <select id="year">
          <option value="2026">2026</option><option value="2027">2027</option>
          <option value="2028">2028</option><option value="2029">2029</option>
          <option value="2030" selected>2030</option><option value="2031">2031</option>
          <option value="2032">2032</option><option value="2033">2033</option><option value="2034">2034</option>
        </select>
        <div class="hint" id="factorhint"></div>
      </div>
      <div class="field">
        <label for="defint">Default intensity, tCO₂e/t (placeholder)</label>
        <input id="defint" type="number" min="0" step="0.01" value="1.55" />
      </div>
      <div class="field">
        <label for="actint">Verified intensity, tCO₂e/t (placeholder)</label>
        <input id="actint" type="number" min="0" step="0.01" value="0.88" />
      </div>
      <div class="field">
        <label for="price">Certificate price, €/tCO₂ (Q1 2026)</label>
        <input id="price" type="number" min="0" step="0.01" value="75.36" />
      </div>
    </div>
    <div>
      <div class="out"><div class="ol">On default values</div><div class="ov" id="o-default"></div><div class="os" id="o-default-s"></div></div>
      <div class="out"><div class="ol">On verified data</div><div class="ov" id="o-actual"></div></div>
      <div class="out"><div class="ol">Difference</div><div class="ov" id="o-save"></div><div class="os" id="o-save-s"></div></div>
      <div class="calc-math" id="math"></div>
    </div>
  </div>

  <p class="muted">Indicative. One fixed certificate price, where the real price moves quarterly in 2026 and weekly from 2027. No carbon price paid in the country of origin. Unverified actuals cannot be used under CBAM, so the default plus mark-up applies to them. For iron and steel, aluminium and hydrogen only direct emissions carry a certificate obligation, so presets that include indirect emissions overstate the figure.</p>

  <script is:inline>
    var FACTOR={2026:.025,2027:.05,2028:.10,2029:.225,2030:.485,2031:.61,2032:.735,2033:.86,2034:1};
    var MARKUP={2026:.10,2027:.20,2028:.30,2029:.30,2030:.30,2031:.30,2032:.30,2033:.30,2034:.30};
    var PRESET={cement:{d:1.55,a:0.88},steel_bf:{d:2.90,a:2.10},steel_eaf:{d:2.90,a:0.70},aluminium:{d:6.50,a:4.00},fertiliser:{d:2.50,a:1.80}};
    var eur=new Intl.NumberFormat('en-IE',{style:'currency',currency:'EUR',maximumFractionDigits:0});
    function $(id){return document.getElementById(id)}
    function preset(){var p=PRESET[$('good').value];$('defint').value=p.d;$('actint').value=p.a;}
    function calc(){
      var y=$('year').value,f=FACTOR[y],m=($('good').value==='fertiliser')?0.01:MARKUP[y];
      var vol=parseFloat($('vol').value)||0,di=parseFloat($('defint').value)||0,ai=parseFloat($('actint').value)||0,pr=parseFloat($('price').value)||0;
      var diM=di*(1+m);
      var defCost=diM*vol*f*pr,actCost=ai*vol*f*pr,save=Math.max(0,defCost-actCost);
      $('o-default').textContent=eur.format(defCost);
      $('o-actual').textContent=eur.format(actCost);
      $('o-save').textContent=eur.format(save);
      $('factorhint').textContent='Phase-in factor '+(f*100).toFixed(1)+'%, default mark-up +'+(m*100)+'%';
      $('o-default-s').textContent=di+' × '+(1+m).toFixed(2)+' = '+diM.toFixed(2)+' tCO₂e/t effective';
      var pct=defCost>0?Math.round(save/defCost*100):0;
      $('o-save-s').textContent=pct+'% of the default-value cost';
      $('math').textContent='default   '+diM.toFixed(2)+' × '+vol.toLocaleString()+' t × '+(f*100).toFixed(1)+'% × €'+pr+'\nverified  '+ai.toFixed(2)+' × '+vol.toLocaleString()+' t × '+(f*100).toFixed(1)+'% × €'+pr;
    }
    $('good').addEventListener('change',function(){preset();calc();});
    ['vol','year','defint','actint','price'].forEach(function(id){$(id).addEventListener('input',calc);$(id).addEventListener('change',calc);});
    preset();calc();
  </script>
</Base>
