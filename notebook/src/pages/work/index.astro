---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { getCollection } from 'astro:content';
import { byNewest, withYearFlags } from '../../lib/format';

const work = (await getCollection('work')).sort(byNewest);
---
<Base title="Work" section="work" description="Instruments and method pieces.">
  <h3>Work</h3>
  <ul class="list">
    {withYearFlags(work).map(({ item, showYear }) => (
      <Entry title={item.data.title} href={item.data.href} created={item.data.created} status={item.data.status} showYear={showYear} />
    ))}
  </ul>
</Base>
