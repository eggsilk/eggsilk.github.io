---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { getCollection } from 'astro:content';
import { byNewest, withYearFlags } from '../../lib/format';

const tools = (await getCollection('tools')).sort(byNewest);
---
<Base title="Tools" section="tools" description="Tools built for emissions monitoring and verification.">
  <h3>Tools</h3>
  <ul class="list">
    {withYearFlags(tools).map(({ item, showYear }) => (
      <Entry title={item.data.title} href={item.data.href} created={item.data.created} status={item.data.status} showYear={showYear} />
    ))}
  </ul>
</Base>
