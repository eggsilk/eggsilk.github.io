---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { getCollection } from 'astro:content';
import { byNewest, withYearFlags, fmtLong } from '../lib/format';

const notes = (await getCollection('notes')).sort(byNewest);
const tools = (await getCollection('tools')).sort(byNewest);
const updated = new Date(Math.max(...[...notes, ...tools].map((e) => (e.data.modified ?? e.data.created).getTime())));
---
<Base title="Ege Ipek" section="home" description="Ege Ipek. Tools and notes on emissions monitoring and verification.">
  <div class="muted">Updated {fmtLong(updated)}</div>

  <p>I build tools for emissions monitoring and verification, and I audit emissions data under the EU ETS and CBAM, as a freelance verifier and as a subcontractor to advisory firms. I live in Berlin.</p>
  <p>Before that I managed monitoring, reporting and filing for industrial carbon-offset projects at a project developer in New York.</p>
  <p>You can reach me via <a href="mailto:mail@example.com">email</a>. Details are on the <a href={u("/about/")}>about</a> page.</p>

  <h3>Notes</h3>
  <ul class="list">
    {withYearFlags(notes).map(({ item, showYear }) => (
      <Entry title={item.data.title} href={item.data.draft ? undefined : `/notes/${item.id}/`} created={item.data.created} status={item.data.status} showYear={showYear} />
    ))}
  </ul>

  <h3>Tools</h3>
  <ul class="list">
    {withYearFlags(tools).map(({ item, showYear }) => (
      <Entry title={item.data.title} href={item.data.href} created={item.data.created} status={item.data.status} showYear={showYear} />
    ))}
  </ul>
</Base>
