---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { getCollection } from 'astro:content';
import { byNewest, withYearFlags, fmtLong } from '../lib/format';

const notes = (await getCollection('notes')).sort(byNewest);
const tools = (await getCollection('tools')).sort(byNewest);
const updated = new Date(Math.max(...[...notes, ...tools].map((e) => (e.data.modified ?? e.data.created).getTime())));
---
<Base title="Climate&Eggs" section="home" description="Climate&Eggs, by Ege Ipek. Tools and notes on emissions monitoring and verification.">
  <div class="muted">Updated {fmtLong(updated)}</div>

  <p>Climate&Eggs is my website where I showcase tools, ideas, and opinions around industrial decarbonization.</p>
  <p>Currently my focus is on the measurement of carbon emissions from the heavy emitters, and the financial and regulatory schemes around said emissions.</p>
  <p>If any of this is remotely interesting to you, I would love to get in touch.</p>

  <h3>Tools</h3>
  <ul class="list">
    {withYearFlags(tools).map(({ item, showYear }) => (
      <Entry title={item.data.title} href={item.data.href} created={item.data.created} status={item.data.status} showYear={showYear} />
    ))}
  </ul>
  {notes.length > 0 && (
    <h3>Notes</h3>
    <ul class="list">
      {withYearFlags(notes).map(({ item, showYear }) => (
        <Entry title={item.data.title} href={item.data.draft ? undefined : `/notes/${item.id}/`} created={item.data.created} status={item.data.status} showYear={showYear} />
      ))}
    </ul>
  )}

</Base>
