---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { getCollection } from 'astro:content';
import { byNewest, withYearFlags } from '../../lib/format';

const notes = (await getCollection('notes')).sort(byNewest);
---
<Base title="Notes" section="notes" description="Notes on CBAM and EU ETS monitoring, reporting and verification.">
  <h3>Notes</h3>
  <ul class="list">
    {withYearFlags(notes).map(({ item, showYear }) => (
      <Entry title={item.data.title} href={item.data.draft ? undefined : `/notes/${item.id}/`} created={item.data.created} status={item.data.status} showYear={showYear} />
    ))}
  </ul>
</Base>
