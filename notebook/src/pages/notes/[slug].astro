---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { fmtLong, statusLabel } from '../../lib/format';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.filter((n) => !n.data.draft).map((n) => ({ params: { slug: n.id }, props: { note: n } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const d = note.data;
const kindLabel: Record<string, string> = { finding: 'Finding', position: 'Position', explainer: 'Explainer' };
const allNotes = await getCollection('notes');
const related = d.related.map((slug) => allNotes.find((n) => n.id === slug)).filter(Boolean);
const line = [
  fmtLong(d.created),
  d.modified ? `revised ${fmtLong(d.modified)}` : null,
  `${d.id}, ${kindLabel[d.kind].toLowerCase()}`,
  d.status !== 'published' ? statusLabel(d.status) : null,
  d.confidence ? `confidence ${d.confidence.replace('-', ' ')}` : null,
].filter(Boolean).join(' · ');
---
<Base title={d.title} section="notes" description={d.gloss}>
  <header class="head">
    <h1>{d.title}</h1>
    <div class="line">{line}</div>
  </header>

  <div class="prose">
    <Content />
  </div>

  {d.unverified.length > 0 && (
    <section class="tail">
      <h2 style="padding-top:0">Unverified</h2>
      <ol class="unv">{d.unverified.map((u) => <li>{u}</li>)}</ol>
    </section>
  )}

  {d.sources.length > 0 && (
    <section class="tail" id="sources">
      <h2 style="padding-top:0">Sources</h2>
      <ol>{d.sources.map((s) => <li>{s.href ? <a href={s.href}>{s.label}</a> : s.label}</li>)}</ol>
    </section>
  )}

  {related.length > 0 && (
    <p class="muted">See also {related.map((r, i) => <><a href={`/notes/${r!.id}/`}>{r!.data.title}</a>{i < related.length - 1 ? ', ' : ''}</>)}.</p>
  )}
</Base>
